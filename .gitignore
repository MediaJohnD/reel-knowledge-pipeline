.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.pyright/
.claude/scheduled_tasks.lock
.playwright-mcp/

.env
.env.*
!.env.example

# Scratch state for superpowers:subagent-driven-development - not project output.
.superpowers/

# Generated/runtime data - keep the directories, ignore their contents.
data/inbox/*
!data/inbox/.gitkeep
data/logs/*
!data/logs/.gitkeep
data/tmp/*
!data/tmp/.gitkeep
data/notes/*
!data/notes/.gitkeep
data/generated_skills/*
!data/generated_skills/.gitkeep
data/review/*
backups/
*.bak-*

# Generated per machine by scripts/review_new_reels.py --gen-have
config/have.txt

# Each person's reviewer profile (businesses, logins, interests); see owner_profile.example.yaml
config/owner_profile.yaml
