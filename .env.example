# Copy to .env and fill in real values. Never commit .env.
# All values here are placeholders - no real secrets.

# Only required if config/settings.yaml's llm.provider is "anthropic" (not needed
# for the default "ollama" provider - see llm.ollama_host in settings.yaml instead).
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Required to accept webhook submissions. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
REEL_WEBHOOK_SECRET=change-me-to-a-long-random-value

# Transcription backend: "local" (faster-whisper, runs on this machine) or "openai" (hosted API).
REEL_TRANSCRIPTION_BACKEND=local

# Required only when REEL_TRANSCRIPTION_BACKEND=openai
OPENAI_API_KEY=sk-your-key-here

# Only required if config/settings.yaml's llm.provider is "groq", "gemini", or "cerebras"
# respectively.
# Groq: https://console.groq.com/keys (free tier, fast inference).
# Gemini: https://aistudio.google.com/apikey (free tier, 500 req/day on Flash models).
# Cerebras: https://cloud.cerebras.ai/ (free tier, 1M tokens/day, fast wafer-scale inference).
# Stick to non-Chinese-origin models on Cerebras (e.g. gpt-oss-120b) - see CLAUDE.md's
# Chinese provider blocklist.
GROQ_API_KEY=gsk-your-key-here
GEMINI_API_KEY=your-gemini-key-here
CEREBRAS_API_KEY=your-cerebras-key-here

# Where finished Obsidian notes are written. Defaults to ./data/notes if unset.
# Point this at your real vault, e.g. C:/Users/you/ObsidianVault/reel-notes
REEL_VAULT_DIR=

# Where generated skill artifacts (from high-signal content) are written.
# Defaults to ./data/generated_skills if unset.
REEL_SKILLS_DIR=

# Host/port for the webhook server.
REEL_WEBHOOK_HOST=127.0.0.1
REEL_WEBHOOK_PORT=8787

# Instagram requires an authenticated session to download reliably (see docs/runbook.md).
# Set exactly one of these - REEL_INSTAGRAM_COOKIES_FILE takes precedence if both are set.
# Use your own real account for low-volume personal use; never commit the cookies file.
# REEL_INSTAGRAM_COOKIES_FILE=C:/Users/you/instagram-cookies.txt
# REEL_INSTAGRAM_COOKIES_BROWSER=chrome

# Optional cookies for everything else yt-dlp handles (YouTube, Facebook, LinkedIn,
# TikTok, X/Twitter, Vimeo). Public YouTube works without these; Facebook and LinkedIn
# generally require them for most content, the same way Instagram does. Set exactly
# one - REEL_YTDLP_COOKIES_FILE takes precedence if both are set. See docs/runbook.md.
# REEL_YTDLP_COOKIES_FILE=C:/Users/you/ytdlp-cookies.txt
# REEL_YTDLP_COOKIES_BROWSER=chrome

# GitHub and Notion text capture (github.com, notion.so/notion.site links)
# need no configuration here - both are public-links-only, no API keys or
# OAuth. See docs/runbook.md's "GitHub and Notion text capture" section.
